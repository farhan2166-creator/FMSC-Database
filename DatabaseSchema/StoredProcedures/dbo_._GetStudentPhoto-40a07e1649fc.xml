<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetStudentPhoto]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXEC dbo.RequirePermission @UserId, N'Students.View';

    IF NOT EXISTS (SELECT 1 FROM dbo.Students WHERE AdmissionId = @AdmissionId)
        THROW 56660, 'The selected student was not found.', 1;

    SELECT
        AdmissionId,
        PhotoData,
        FileName,
        ContentType,
        UpdatedAt
    FROM dbo.StudentPhotos
    WHERE AdmissionId = @AdmissionId;
END;</ns0:Value>
