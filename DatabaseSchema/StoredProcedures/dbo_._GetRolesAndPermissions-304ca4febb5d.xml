<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetRolesAndPermissions]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequireAnyPermission
        @UserId,
        N'System.Roles',
        N'System.Administration';

    SELECT
        R.RoleId,
        R.RoleName,
        P.PermissionId,
        P.PermissionCode,
        P.PermissionName
    FROM dbo.Roles R
    LEFT JOIN dbo.RolePermissions RP ON RP.RoleId=R.RoleId
    LEFT JOIN dbo.Permissions P ON P.PermissionId=RP.PermissionId
    ORDER BY R.RoleName,P.PermissionCode;
END;</ns0:Value>
