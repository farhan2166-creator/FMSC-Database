<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetAuditTableNames]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequireAnyPermission
        @UserId,
        N'System.Audit',
        N'System.Administration';

    SELECT DISTINCT
        TableName
    FROM dbo.AuditLogs
    WHERE NULLIF(LTRIM(RTRIM(TableName)), N'') IS NOT NULL
    ORDER BY TableName;
END;</ns0:Value>
			</ns0:Property>
