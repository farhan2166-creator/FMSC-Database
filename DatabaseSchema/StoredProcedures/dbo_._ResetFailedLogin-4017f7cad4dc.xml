<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[ResetFailedLogin]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;

    /* FIX 54 - FMSC sign-in throttle. See the note on @TargetUserId in
       dbo.RecordFailedLogin. The WHERE clause keeps a successful sign-in from
       writing to the row at all in the normal case where nothing is recorded. */

    UPDATE dbo.Users
    SET
        FailedLoginCount = 0,
        LockedUntil = NULL
    WHERE UserId = @TargetUserId
      AND (FailedLoginCount &lt;&gt; 0 OR LockedUntil IS NOT NULL);
END;</ns0:Value>
