<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetFeeTypes]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    EXECUTE dbo.RequirePermission @UserId, N'Fees.View';
    SET NOCOUNT ON;
    SELECT   FeeTypeId,
             FeeTypeCode,
             FeeTypeName,
             Description,
             DisplayOrder,
             IsSystemDefined,
             ISNULL(DefaultFrequency, N'Monthly') AS DefaultFrequency
    FROM     dbo.FeeTypes
    ORDER BY DisplayOrder, FeeTypeName;
END</ns0:Value>
