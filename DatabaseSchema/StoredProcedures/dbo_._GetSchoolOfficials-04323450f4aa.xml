<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetSchoolOfficials]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXECUTE dbo.RequireAuthenticatedUser @UserId;
    SELECT   SchoolOfficialId,
             Designation,
             PersonName,
             CreatedAt,
             CreatedByUserId,
             UpdatedAt,
             UpdatedByUserId
    FROM     dbo.SchoolOfficials
    ORDER BY Designation, PersonName;
END</ns0:Value>
