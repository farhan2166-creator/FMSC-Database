<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[CheckClassFeeConfiguration]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXECUTE dbo.RequirePermission @UserId, N'Enrollment.Manage';
    SELECT   FT.FeeTypeCode,
             FT.FeeTypeName
    FROM     dbo.FeeTypes AS FT
    WHERE    FT.IsMandatory = 1
             AND NOT EXISTS (SELECT 1
                             FROM   dbo.FeeConfigurations AS FC
                             WHERE  FC.CampusId = @CampusId
                                    AND FC.ClassId = @ClassId
                                    AND FC.FeeTypeId = FT.FeeTypeId)
    ORDER BY FT.FeeTypeCode;
END</ns0:Value>
