<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetRegularStudentCertificateRecords]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Create';

    SELECT
        RSC.RegularStudentCertificateId,
        RSC.AdmissionId,

        RSC.StudentName,
        RSC.FatherName,
        RSC.DateOfBirth,
        RSC.ClassName,
        RSC.CertificateDate,

        RSC.CreatedAt,
        RSC.UpdatedAt

    FROM dbo.RegularStudentCertificates AS RSC

    WHERE
        @AdmissionId = 0
        OR RSC.AdmissionId = @AdmissionId

    ORDER BY
        RSC.RegularStudentCertificateId DESC;
END;</ns0:Value>
