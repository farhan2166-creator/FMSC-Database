<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetUserPermissions]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    IF EXISTS (SELECT 1
               FROM   dbo.Users AS U
                      INNER JOIN
                      dbo.Roles AS R
                      ON R.RoleId = U.RoleId
               WHERE  U.UserId = @UserId
                      AND R.RoleName = N'Administrator')
       OR EXISTS (SELECT 1
                  FROM   dbo.Users AS U
                         INNER JOIN
                         dbo.UserRoles AS UR
                         ON UR.UserId = U.UserId
                         INNER JOIN
                         dbo.Roles AS R
                         ON R.RoleId = UR.RoleId
                  WHERE  U.UserId = @UserId
                         AND R.RoleName = N'Administrator')
        BEGIN
            SELECT   P.PermissionId,
                     P.PermissionCode,
                     P.PermissionName
            FROM     dbo.Permissions AS P
            ORDER BY P.PermissionCode;
            RETURN;
        END
    SELECT   DISTINCT P.PermissionId,
                      P.PermissionCode,
                      P.PermissionName
    FROM     dbo.Users AS U
             INNER JOIN
             dbo.UserRoles AS UR
             ON UR.UserId = U.UserId
             INNER JOIN
             dbo.Roles AS R
             ON R.RoleId = UR.RoleId
             INNER JOIN
             dbo.RolePermissions AS RP
             ON RP.RoleId = R.RoleId
             INNER JOIN
             dbo.Permissions AS P
             ON P.PermissionId = RP.PermissionId
    WHERE    U.UserId = @UserId
    ORDER BY P.PermissionCode;
END</ns0:Value>
