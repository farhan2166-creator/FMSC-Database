<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetRoles]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXECUTE dbo.RequireAnyPermission @UserId, N'System.Roles', N'System.Users', N'System.Administration';
    SELECT   RoleId,
             RoleName,
             Description
    FROM     dbo.Roles
    ORDER BY RoleName;
END</ns0:Value>
