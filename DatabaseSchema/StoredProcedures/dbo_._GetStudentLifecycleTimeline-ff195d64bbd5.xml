				<ns0:Property Name="HeaderContents" Value="&#13;&#10;------------------------------------------------------------------------------&#13;&#10;-- 4. dbo.GetStudentLifecycleTimeline&#13;&#10;------------------------------------------------------------------------------&#13;&#10;--&#13;&#10;-- One merged, chronological feed of everything that has ever happened to&#13;&#10;-- a student's admission/enrollment/leave record, for the Console's history&#13;&#10;-- panel. EnrollmentHistory and StudentStatusHistory already record almost&#13;&#10;-- everything the app does to a student (transfers, promotions, re-admits,&#13;&#10;-- status changes, and now corrections); LeaveCertificates rows are folded&#13;&#10;-- in too since a created leave record is itself a lifecycle event.&#13;&#10;&#13;&#10;CREATE   PROCEDURE dbo.GetStudentLifecycleTimeline&#13;&#10;    @UserId INT,&#13;&#10;    @AdmissionId INT&#13;&#10;AS" />
