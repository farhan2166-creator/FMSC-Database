<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetUserForLogin]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    SELECT U.UserId,
           U.Username,
           U.PasswordHash,
           U.PasswordSalt,
           U.MustChangePassword,
           U.FailedLoginCount,
           U.LockedUntil,
           CASE WHEN U.RoleId = (SELECT   TOP (1) R.RoleId
                                 FROM     dbo.Roles AS R
                                 WHERE    R.RoleName = N'Administrator'
                                 ORDER BY R.RoleId) THEN N'Administrator' ELSE ISNULL(STUFF((SELECT   N', ' + R2.RoleName
                                                                                             FROM     dbo.UserRoles AS UR2
                                                                                                      INNER JOIN
                                                                                                      dbo.Roles AS R2
                                                                                                      ON R2.RoleId = UR2.RoleId
                                                                                             WHERE    UR2.UserId = U.UserId
                                                                                             ORDER BY R2.RoleName
                                                                                             FOR      XML PATH (N''), TYPE).value(N'.', N'nvarchar(max)'), 1, 2, N''), N'No Roles') END AS RoleName
    FROM   dbo.Users AS U
    WHERE  U.Username = @Username;
END</ns0:Value>
