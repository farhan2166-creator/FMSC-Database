<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetAcademicPrograms]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXECUTE dbo.RequireAuthenticatedUser @UserId;
    SELECT   AcademicProgramId,
             ProgramCode,
             ProgramName,
             ProgramType,
             DisplayOrder
    FROM     dbo.AcademicPrograms
    WHERE    (NULLIF (LTRIM(RTRIM(@ProgramType)), N'') IS NULL
              OR ProgramType = @ProgramType)
    ORDER BY DisplayOrder, AcademicProgramId;
END</ns0:Value>
