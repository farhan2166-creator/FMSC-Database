<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[DeleteClass]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    SET XACT_ABORT ON;
    EXEC dbo.RequirePermission @UserId, N'System.Setup';

    IF NOT EXISTS (SELECT 1 FROM dbo.Classes WHERE ClassId = @ClassId)
        THROW 59021, 'The selected class was not found.', 1;
    IF EXISTS (SELECT 1 FROM dbo.CampusClassSections WHERE ClassId = @ClassId)
        THROW 59022, 'This class is assigned to one or more campus/section combinations and cannot be deleted. Deactivate it instead.', 1;
    IF EXISTS (SELECT 1 FROM dbo.FeeConfigurations WHERE ClassId = @ClassId)
        THROW 59024, 'This class has fee configuration and cannot be deleted. Deactivate it instead.', 1;
    IF EXISTS (SELECT 1 FROM dbo.PromotionBatches WHERE SourceClassId = @ClassId)
        THROW 59025, 'This class is referenced by promotion history and cannot be deleted. Deactivate it instead.', 1;

    DELETE FROM dbo.Classes WHERE ClassId = @ClassId;
END;</ns0:Value>
			</ns0:Property>
