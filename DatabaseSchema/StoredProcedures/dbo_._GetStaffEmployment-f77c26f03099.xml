<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetStaffEmployment]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequireAuthenticatedUser @UserId;

    SELECT
        se.StaffEmploymentId,
        se.StaffId,
        s.StaffNumber,
        s.StaffName,
        s.FatherName,
        se.Designation,
        se.Department,
        se.EmploymentType,
        se.HireDate,
        se.LeavingDate,
        se.Status,
        se.Remarks,
        se.CreatedAt,
        se.UpdatedAt
    FROM dbo.StaffEmployment AS se
    INNER JOIN dbo.Staff AS s
        ON s.StaffId = se.StaffId
    WHERE
        @StaffId = 0
        OR se.StaffId = @StaffId
    ORDER BY
        s.StaffName,
        se.HireDate DESC,
        se.StaffEmploymentId DESC;
END;</ns0:Value>
