<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetCharacterCertificatePrintData]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Print';

    IF @CertificateRecordId &lt;= 0
        THROW 58300, 'A valid character certificate is required.', 1;

    SELECT
        CC.CertificateRecordId,
        CC.AdmissionId,

        CC.CertificateNumber AS CertificateNumber,

        CC.StudentName,
        CC.FatherName,
        CC.Gender,
        CC.LastExamYear,
        CC.RollNumber,
        CC.Remarks,
        CC.CertificateDate,
        CC.CreatedAt AS DateOfIssue

    FROM dbo.CharacterCertificates AS CC
    WHERE CC.CertificateRecordId = @CertificateRecordId;
END;</ns0:Value>
			</ns0:Property>
