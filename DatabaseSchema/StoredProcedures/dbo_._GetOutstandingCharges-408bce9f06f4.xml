<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetOutstandingCharges]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    EXECUTE dbo.RequirePermission @UserId, N'Fees.View';
    SET NOCOUNT ON;
    IF @AsOfDate IS NULL
        SET @AsOfDate = CAST (GETDATE() AS DATE);
    SELECT   BC.BillingChargeId,
             BC.StudentFeeAssignmentId,
             BC.EnrollmentId,
             BC.AdmissionId,
             FT.FeeTypeId,
             FT.FeeTypeCode,
             FT.FeeTypeName,
             BC.BillingMonth,
             BC.ChargeKind,
             BC.Remarks,
             BC.ChargeDate,
             BC.DueDate,
             BC.GrossAmount,
             BC.DiscountAmount,
             BC.NetAmount,
             BC.NetAmount - dbo.GetFeeChargeBalance(BC.BillingChargeId) AS PaidAmount,
             dbo.GetFeeChargeBalance(BC.BillingChargeId) AS Balance,
             BC.Status
    FROM     dbo.BillingCharges AS BC
             INNER JOIN
             dbo.FeeTypes AS FT
             ON FT.FeeTypeId = BC.FeeTypeId
    WHERE    BC.AdmissionId = @AdmissionId
             AND BC.EnrollmentId = @EnrollmentId
             AND BC.Status &lt;&gt; N'Cancelled'
             AND dbo.GetFeeChargeBalance(BC.BillingChargeId) &gt; 0
    ORDER BY CASE WHEN BC.BillingMonth IS NULL THEN 0 ELSE 1 END, BC.BillingMonth, FT.DisplayOrder, FT.FeeTypeName;
END</ns0:Value>
