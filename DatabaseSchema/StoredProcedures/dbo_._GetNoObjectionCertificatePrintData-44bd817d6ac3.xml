<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetNoObjectionCertificatePrintData]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Print';

    IF @NoObjectionCertificateId &lt;= 0
        THROW 58620, 'A valid NOC is required.', 1;

    SELECT
        NOC.NoObjectionCertificateId,
        NOC.AdmissionId,

        NOC.CertificateNumber AS CertificateNumber,

        NOC.StudentName,
        NOC.FatherName,
        NOC.CertificateDate,
        NOC.CreatedAt AS DateOfIssue

    FROM dbo.NoObjectionCertificates AS NOC
    WHERE NOC.NoObjectionCertificateId = @NoObjectionCertificateId;
END;</ns0:Value>
