<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetCampuses]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="False" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXECUTE dbo.RequireAuthenticatedUser @UserId;
    SELECT DisplayOrder, CampusId,
             CampusCode,
             CampusName,
             CampusType,
             AddressLine,
             City,
             ContactNumber,
             Email
    FROM     dbo.Campuses
    ORDER BY DisplayOrder, CampusId;
END</ns0:Value>
