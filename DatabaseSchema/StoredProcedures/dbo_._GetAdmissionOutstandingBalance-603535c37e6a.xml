<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetAdmissionOutstandingBalance]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission @UserId, N'Reports.View';

    SELECT ISNULL(SUM(dbo.GetFeeChargeBalance(BC.BillingChargeId)), 0)
    FROM dbo.BillingCharges BC
    WHERE BC.AdmissionId = @AdmissionId
      AND BC.Status &lt;&gt; N'Cancelled';
END;</ns0:Value>
			</ns0:Property>
			<ns0:Property Name="IsAnsiNullsOn" Value="True" />
