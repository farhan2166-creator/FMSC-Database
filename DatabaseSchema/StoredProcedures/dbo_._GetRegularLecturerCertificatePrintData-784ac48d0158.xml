<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetRegularLecturerCertificatePrintData]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Print';

    IF @RegularLecturerCertificateId &lt;= 0
        THROW 58720, 'A valid certificate is required.', 1;

    SELECT
        RLC.RegularLecturerCertificateId,
        RLC.StaffId,

        RLC.CertificateNumber AS CertificateNumber,

        RLC.StaffName,
        RLC.FatherName,
        RLC.Gender,
        RLC.RoleTitle,
        RLC.SubjectTaught,
        RLC.CertificateDate,
        RLC.CreatedAt AS DateOfIssue,

        SP.SchoolName AS InstitutionLine

    FROM dbo.RegularLecturerCertificates AS RLC

    CROSS JOIN dbo.SchoolProfile AS SP

    WHERE RLC.RegularLecturerCertificateId = @RegularLecturerCertificateId
      AND SP.SchoolProfileId = 1;
END;</ns0:Value>
