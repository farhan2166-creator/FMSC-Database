<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetSchoolProfile]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequireAuthenticatedUser @UserId;

    SELECT
        SchoolProfileId,
        SchoolName,
        AddressLine,
        City,
        ContactNumber,
        Email,
        LogoImage,
        LogoFileName,
        LogoContentType,
        FeeProrationCutoffDay,
        CreatedAt,
        CreatedByUserId,
        UpdatedAt,
        UpdatedByUserId
    FROM dbo.SchoolProfile
    WHERE SchoolProfileId = 1;
END;</ns0:Value>
