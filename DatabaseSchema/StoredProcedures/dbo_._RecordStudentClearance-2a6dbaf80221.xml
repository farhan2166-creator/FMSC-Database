<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[RecordStudentClearance]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission @UserId, N'Students.Administer';

    IF NOT EXISTS (SELECT 1 FROM dbo.Students WHERE AdmissionId = @AdmissionId)
        THROW 52703, 'The student was not found.', 1;

    INSERT INTO dbo.StudentClearanceRecords
    (
        AdmissionId,
        OutstandingBalance,
        ChecklistJson,
        Remarks,
        ClearedByUserId
    )
    VALUES
    (
        @AdmissionId,
        @OutstandingBalance,
        @ChecklistJson,
        @Remarks,
        @UserId
    );

    SELECT SCOPE_IDENTITY() AS ClearanceRecordId;
END;</ns0:Value>
