<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetBankAccountOpeningCertificateRecords]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Create';

    SELECT
        BAC.BankAccountOpeningCertificateId,
        BAC.StaffId,

        BAC.StaffName,
        BAC.FatherName,
        BAC.Designation,
        BAC.BankName,
        BAC.BranchName,
        BAC.MonthlyIncome,
        BAC.Purpose,
        BAC.CertificateDate,

        BAC.CreatedAt,
        BAC.UpdatedAt

    FROM dbo.BankAccountOpeningCertificates AS BAC

    WHERE
        @StaffId = 0
        OR BAC.StaffId = @StaffId

    ORDER BY
        BAC.BankAccountOpeningCertificateId DESC;
END;</ns0:Value>
