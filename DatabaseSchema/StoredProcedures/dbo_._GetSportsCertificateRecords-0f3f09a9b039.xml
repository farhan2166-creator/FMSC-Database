<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetSportsCertificateRecords]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Create';

    SELECT
        SC.SportsCertificateId,
        SC.AdmissionId,

        SC.StudentName,
        SC.FatherName,
        SC.SportName,
        SC.Performance,
        SC.CertificateDate,

        SC.CreatedAt,
        SC.UpdatedAt

    FROM dbo.SportsCertificates AS SC

    WHERE
        @AdmissionId = 0
        OR SC.AdmissionId = @AdmissionId

    ORDER BY
        SC.SportsCertificateId DESC;
END;</ns0:Value>
