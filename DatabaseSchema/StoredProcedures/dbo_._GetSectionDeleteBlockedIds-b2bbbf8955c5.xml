<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetSectionDeleteBlockedIds]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXEC dbo.RequirePermission @UserId, N'System.Setup';

    SELECT S.SectionId AS Id
    FROM dbo.Sections S
    WHERE EXISTS (SELECT 1 FROM dbo.CampusClassSections X WHERE X.SectionId = S.SectionId)
       OR EXISTS (SELECT 1 FROM dbo.PromotionBatches X WHERE X.SourceSectionId = S.SectionId);
END;</ns0:Value>
