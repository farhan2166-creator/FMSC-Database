<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetFeeConfigurations]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXECUTE dbo.RequirePermission @UserId, N'Fees.View';
    IF @CampusId &lt;= 0
        THROW 56320, 'Please select a campus first.', 1;
    IF @ClassId &lt;= 0
       AND @AllClasses = 0
        THROW 56322, 'Please select a class first.', 1;
    SELECT   FC.FeeConfigurationId,
             FC.CampusId,
             FC.ClassId,
             FC.FeeTypeId,
             FT.FeeTypeCode,
             FT.FeeTypeName,
             FC.Amount,
             FC.Frequency,
             FC.Remarks,
             FT.IsMandatory,
             FT.IsTransportLinked
    FROM     dbo.FeeConfigurations AS FC
             INNER JOIN
             dbo.FeeTypes AS FT
             ON FT.FeeTypeId = FC.FeeTypeId
    WHERE    FC.CampusId = @CampusId
             AND (@AllClasses = 1
                  OR FC.ClassId = @ClassId)
    ORDER BY FC.ClassId, FT.DisplayOrder, FT.FeeTypeName;
END</ns0:Value>
			</ns0:Property>
