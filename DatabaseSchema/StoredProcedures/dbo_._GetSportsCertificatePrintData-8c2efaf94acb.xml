<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetSportsCertificatePrintData]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Print';

    IF @SportsCertificateId &lt;= 0
        THROW 58420, 'A valid sports certificate is required.', 1;

    SELECT
        SC.SportsCertificateId,
        SC.AdmissionId,

        SC.CertificateNumber AS CertificateNumber,

        SC.StudentName,
        SC.FatherName,
        SC.SportName,
        SC.Performance,
        SC.CertificateDate,
        SC.CreatedAt AS DateOfIssue

    FROM dbo.SportsCertificates AS SC
    WHERE SC.SportsCertificateId = @SportsCertificateId;
END;</ns0:Value>
