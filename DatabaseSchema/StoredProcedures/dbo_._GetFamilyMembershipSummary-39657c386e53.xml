<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetFamilyMembershipSummary]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Students.View';

    SELECT
        L.AdmissionId,
        FM.FamilyId,
        (
            SELECT COUNT(*)
            FROM dbo.FamilyMembers FM2
            WHERE FM2.FamilyId = FM.FamilyId
        ) AS FamilyMemberCount
    FROM @AdmissionIds L
    LEFT JOIN dbo.FamilyMembers FM
        ON FM.AdmissionId = L.AdmissionId;
END;</ns0:Value>
