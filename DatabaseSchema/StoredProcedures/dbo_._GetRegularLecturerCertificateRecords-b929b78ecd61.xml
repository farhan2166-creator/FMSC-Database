<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetRegularLecturerCertificateRecords]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Create';

    SELECT
        RLC.RegularLecturerCertificateId,
        RLC.StaffId,

        RLC.StaffName,
        RLC.FatherName,
        RLC.RoleTitle,
        RLC.SubjectTaught,
        RLC.CertificateDate,

        RLC.CreatedAt,
        RLC.UpdatedAt

    FROM dbo.RegularLecturerCertificates AS RLC

    WHERE
        @StaffId = 0
        OR RLC.StaffId = @StaffId

    ORDER BY
        RLC.RegularLecturerCertificateId DESC;
END;</ns0:Value>
