<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[ResolveDuplicateStudentReview]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission @UserId, N'Students.Administer';

    IF @Status NOT IN (N'Confirmed', N'Dismissed')
        THROW 52701, 'Status must be Confirmed or Dismissed.', 1;

    UPDATE dbo.DuplicateStudentReviews
    SET
        Status = @Status,
        ReviewedByUserId = @UserId,
        ReviewedAt = SYSDATETIME()
    WHERE ReviewId = @ReviewId;

    IF @@ROWCOUNT = 0
        THROW 52702, 'The candidate pair was not found - it may have already been resolved.', 1;
END;</ns0:Value>
