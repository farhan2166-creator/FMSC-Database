<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetLeaveCertificatePrintData]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Students.Leave';

    IF @LeaveRecordId &lt;= 0
        THROW 57310,
            'A valid leave certificate is required.',
            1;

    DECLARE @CopyType NVARCHAR(20);

    IF @LeaveCertificateIssueId &gt; 0
        SELECT @CopyType = IssueType
        FROM dbo.LeaveCertificateIssues
        WHERE LeaveCertificateIssueId = @LeaveCertificateIssueId
          AND LeaveRecordId = @LeaveRecordId;

    IF @CopyType IS NULL
        SELECT TOP (1)
            @CopyType = IssueType
        FROM dbo.LeaveCertificateIssues
        WHERE LeaveRecordId = @LeaveRecordId
        ORDER BY
            IssuedAt DESC,
            LeaveCertificateIssueId DESC;

    SELECT
        LC.LeaveRecordId,
        LC.AdmissionId,

        LC.CertificateNumber AS CertificateNumber,

        LC.StudentName,
        LC.FatherName,
        LC.DateOfBirth,
        LC.DateOfAdmission,
        LC.ClassStudied,
        LC.ClassPromotedTo,
        LC.LeaveDate,
        LC.AcademicRecord,
        LC.AttendanceRecord,
        LC.Remarks,
        LC.CreatedAt AS DateOfIssue,
        ISNULL(@CopyType, N'Original') AS CopyType

    FROM dbo.LeaveCertificates AS LC
    WHERE LC.LeaveRecordId = @LeaveRecordId;
END;</ns0:Value>
