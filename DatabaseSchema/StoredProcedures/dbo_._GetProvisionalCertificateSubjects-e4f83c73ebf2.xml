<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetProvisionalCertificateSubjects]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXECUTE dbo.RequirePermission @UserId, N'Certificates.Create';
    SELECT   PCS.SubjectId,
             PCS.SubjectName,
             PCS.DisplayOrder
    FROM     dbo.ProvisionalCertificateSubjects AS PCS
    WHERE    PCS.ProvisionalCertificateId = @ProvisionalCertificateId
    ORDER BY PCS.DisplayOrder, PCS.SubjectName;
END</ns0:Value>
