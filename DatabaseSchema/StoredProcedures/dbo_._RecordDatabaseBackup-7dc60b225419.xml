<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[RecordDatabaseBackup]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    IF NOT EXISTS (SELECT 1
                   FROM   dbo.Users
                   WHERE  UserId = @UserId)
        THROW 50001, 'The specified user does not exist.', 1;
    INSERT  INTO dbo.DatabaseBackups (Operation, FileName, FilePath, FileSizeBytes, BackupDate, Status, UserId, Remarks)
    VALUES                          (@Operation, @FileName, @FilePath, @FileSizeBytes, SYSUTCDATETIME(), @Status, @UserId, @Remarks);
END</ns0:Value>
