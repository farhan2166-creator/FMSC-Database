<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetBankAccountOpeningCertificatePrintData]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Print';

    IF @BankAccountOpeningCertificateId &lt;= 0
        THROW 58820, 'A valid certificate is required.', 1;

    SELECT
        BAC.BankAccountOpeningCertificateId,
        BAC.StaffId,

        BAC.CertificateNumber AS CertificateNumber,

        BAC.StaffName,
        BAC.FatherName,
        BAC.Gender,
        BAC.CNIC,
        BAC.Designation,
        BAC.BankName,
        BAC.BranchName,
        BAC.MonthlyIncome,
        BAC.Purpose,
        BAC.CertificateDate,
        BAC.CreatedAt AS DateOfIssue,

        SP.SchoolName AS InstitutionLine

    FROM dbo.BankAccountOpeningCertificates AS BAC

    CROSS JOIN dbo.SchoolProfile AS SP

    WHERE BAC.BankAccountOpeningCertificateId = @BankAccountOpeningCertificateId
      AND SP.SchoolProfileId = 1;
END;</ns0:Value>
