<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetCharacterCertificateRecords]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Create';

    SELECT
        CC.CertificateRecordId,
        CCI.CharacterCertificateIssueId,
        CC.AdmissionId,

        CC.StudentName,
        CC.FatherName,
        CC.RollNumber,
        CC.LastExamYear,
        CC.CertificateDate,

        CCI.IssuedAt,
        CCI.IssuedByUserId,
        U.Username AS IssuedBy,

        CCI.CollectedAt,
        CCI.CollectedBy,

        CASE
            WHEN CCI.CollectedAt IS NULL
                THEN N'Not Collected'
            ELSE N'Collected'
        END AS CollectionStatus

    FROM dbo.CharacterCertificates AS CC

    INNER JOIN dbo.CharacterCertificateIssues AS CCI
        ON CCI.CertificateRecordId = CC.CertificateRecordId

    LEFT JOIN dbo.Users AS U
        ON U.UserId = CCI.IssuedByUserId

    WHERE
        @AdmissionId = 0
        OR CC.AdmissionId = @AdmissionId

    ORDER BY
        CC.CertificateRecordId DESC,
        CCI.IssuedAt DESC,
        CCI.CharacterCertificateIssueId DESC;
END;</ns0:Value>
