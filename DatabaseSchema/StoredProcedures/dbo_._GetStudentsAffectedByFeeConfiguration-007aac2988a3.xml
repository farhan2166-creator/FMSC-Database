<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetStudentsAffectedByFeeConfiguration]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission @UserId, N'Fees.Configuration.Manage';

    IF NOT EXISTS (
        SELECT 1 FROM dbo.FeeConfigurations
        WHERE CampusId = @CampusId AND ClassId = @ClassId AND FeeTypeId = @FeeTypeId
    )
        THROW 53150, 'No fee configuration exists for the selected campus, class and fee type.', 1;

    SELECT
        X.StudentFeeAssignmentId,
        X.EnrollmentId,
        X.AdmissionId,
        S.RegistrationNumber,
        S.StudentName,
        CAM.CampusName,
        CL.ClassName,
        SEC.SectionName,
        X.CurrentAmount,
        X.NewAmount,
        X.CurrentFrequency,
        X.ConfiguredFrequency,
        X.AssignmentEffectiveFrom,
        (                                                            -- Hardening pass, Step 2
            SELECT MAX(BC.BillingMonth) FROM dbo.BillingCharges BC
          WHERE BC.EnrollmentId = X.EnrollmentId AND BC.FeeTypeId = @FeeTypeId
        ) AS LastBilledMonth                                          -- warn/block per the real data
    FROM dbo.fn_StaleFeeAssignmentsForConfiguration(@CampusId, @ClassId, @FeeTypeId) X
    INNER JOIN dbo.Enrollments E ON E.EnrollmentId = X.EnrollmentId
    INNER JOIN dbo.CampusClassSections CCS ON CCS.ClassSectionId = E.ClassSectionId
    INNER JOIN dbo.Students S ON S.AdmissionId = X.AdmissionId
    INNER JOIN dbo.Campuses CAM ON CAM.CampusId = CCS.CampusId
    INNER JOIN dbo.Classes CL ON CL.ClassId = CCS.ClassId
    LEFT JOIN dbo.Sections SEC ON SEC.SectionId = CCS.SectionId
    ORDER BY S.RegistrationNumber;
END;</ns0:Value>
