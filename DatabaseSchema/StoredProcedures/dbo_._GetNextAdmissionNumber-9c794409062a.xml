<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetNextAdmissionNumber]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXEC dbo.RequirePermission @UserId, N'Students.Admit';
    SELECT CONVERT(VARCHAR(40), LastNumber + 1) AS AdmissionNumber
    FROM dbo.AdmissionNumberCounter WHERE CounterId=1;
END;</ns0:Value>
