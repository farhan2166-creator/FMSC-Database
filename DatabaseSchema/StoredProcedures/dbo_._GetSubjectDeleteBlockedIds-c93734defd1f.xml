<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetSubjectDeleteBlockedIds]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;
    EXEC dbo.RequirePermission @UserId, N'System.Setup';
    SELECT S.SubjectId AS Id
    FROM dbo.Subjects S
    WHERE EXISTS (SELECT 1 FROM dbo.ProvisionalCertificateSubjects X WHERE X.SubjectId = S.SubjectId)
;
END;</ns0:Value>
