    SET NOCOUNT ON;
    EXECUTE dbo.RequirePermission @UserId, N'Students.View';
    SELECT   ItemId,
             ItemText
    FROM     dbo.ClearanceChecklistItems
    ORDER BY DisplayOrder, ItemId;
END</ns0:Value>
