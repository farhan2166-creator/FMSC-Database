<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetNoObjectionCertificateRecords]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Create';

    SELECT
        NOC.NoObjectionCertificateId,
        NOC.AdmissionId,

        NOC.StudentName,
        NOC.FatherName,
        NOC.CertificateDate,

        NOC.CreatedAt,
        NOC.UpdatedAt

    FROM dbo.NoObjectionCertificates AS NOC

    WHERE
        @AdmissionId = 0
        OR NOC.AdmissionId = @AdmissionId

    ORDER BY
        NOC.NoObjectionCertificateId DESC;
END;</ns0:Value>
