<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlProcedure" Name="[dbo].[GetCharacterCertificateFieldSuggestions]">
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    EXEC dbo.RequirePermission
        @UserId,
        N'Certificates.Create';

    IF @Field = N'Remarks'
        SELECT DISTINCT TOP (500) Remarks AS Value
        FROM dbo.CharacterCertificates
        WHERE Remarks IS NOT NULL
          AND LTRIM(RTRIM(Remarks)) &lt;&gt; N''
        ORDER BY Remarks;

    ELSE
        THROW 51600, 'Unknown suggestion field.', 1;
END;</ns0:Value>
