<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlDmlTrigger" Name="[dbo].[TR_RegularLecturerCertificates_CertificateNumberImmutable]">
			<ns0:Property Name="IsUpdateTrigger" Value="True" />
			<ns0:Property Name="SqlTriggerType" Value="2" />
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    SET NOCOUNT ON;

    IF UPDATE(CertificateNumber)
       AND EXISTS
       (
           SELECT 1
           FROM inserted AS I
           INNER JOIN deleted AS D ON D.RegularLecturerCertificateId = I.RegularLecturerCertificateId
           WHERE D.CertificateNumber IS NOT NULL
             AND (I.CertificateNumber IS NULL OR I.CertificateNumber &lt;&gt; D.CertificateNumber)
       )
        THROW 59210, 'A certificate number is issued once and cannot be changed.', 1;
END;</ns0:Value>
			</ns0:Property>
			<ns0:Property Name="IsAnsiNullsOn" Value="True" />
