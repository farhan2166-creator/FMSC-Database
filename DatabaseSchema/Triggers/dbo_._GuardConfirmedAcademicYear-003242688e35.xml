<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlDmlTrigger" Name="[dbo].[GuardConfirmedAcademicYear]">
			<ns0:Property Name="IsUpdateTrigger" Value="True" />
			<ns0:Property Name="SqlTriggerType" Value="2" />
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(SELECT 1 FROM inserted I JOIN deleted D ON D.EnrollmentId=I.EnrollmentId JOIN dbo.Students S ON S.AdmissionId=I.AdmissionId
  WHERE D.PlacementConfirmedAt IS NOT NULL AND S.LegacySetupPending=0
    AND (I.AcademicYearId&lt;&gt;D.AcademicYearId OR I.PlacementConfirmedAt IS NULL))
  THROW 59640,'Academic year is confirmed. Use Promotion for a move to another academic year.',1;
END;</ns0:Value>
			</ns0:Property>
