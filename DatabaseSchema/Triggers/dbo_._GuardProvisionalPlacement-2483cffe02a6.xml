				</ns0:Entry>
				<ns0:Entry>
					<ns0:References Name="[dbo].[Enrollments].[AdmissionId]" />
				</ns0:Entry>
				<ns0:Entry>
					<ns0:References Name="[dbo].[Enrollments].[Status]" />
				</ns0:Entry>
				<ns0:Entry>
					<ns0:References Name="[dbo].[Students].[Status]" />
				</ns0:Entry>
			</ns0:Relationship>
			<ns0:Relationship Name="Parent">
