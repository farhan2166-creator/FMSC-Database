<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlDmlTrigger" Name="[dbo].[GuardProvisionalPlacement]">
			<ns0:Property Name="IsInsertTrigger" Value="True" />
			<ns0:Property Name="IsUpdateTrigger" Value="True" />
			<ns0:Property Name="SqlTriggerType" Value="2" />
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(SELECT 1 FROM inserted I JOIN dbo.Students S ON S.AdmissionId=I.AdmissionId
  WHERE I.Status=N'Active' AND S.Status IN(N'Pending',N'Cancelled'))
  THROW 59752,'Complete Admission before activating this registration. Cancelled records cannot have an active placement.',1;
END;</ns0:Value>
			</ns0:Property>
			<ns0:Property Name="IsAnsiNullsOn" Value="True" />
