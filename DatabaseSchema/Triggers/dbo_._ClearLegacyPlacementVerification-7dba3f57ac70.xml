<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlDmlTrigger" Name="[dbo].[ClearLegacyPlacementVerification]">
			<ns0:Property Name="IsInsertTrigger" Value="True" />
			<ns0:Property Name="IsUpdateTrigger" Value="True" />
			<ns0:Property Name="IsDeleteTrigger" Value="True" />
