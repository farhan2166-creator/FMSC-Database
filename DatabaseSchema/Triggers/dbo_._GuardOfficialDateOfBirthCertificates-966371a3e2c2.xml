<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlDmlTrigger" Name="[dbo].[GuardOfficialDateOfBirthCertificates]">
			<ns0:Property Name="IsInsertTrigger" Value="True" />
			<ns0:Property Name="IsUpdateTrigger" Value="True" />
			<ns0:Property Name="SqlTriggerType" Value="2" />
			<ns0:Property Name="BodyScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
 SET NOCOUNT ON;
 IF EXISTS(SELECT 1 FROM inserted I JOIN dbo.Students S ON S.AdmissionId=I.AdmissionId WHERE S.Status IN(N'Pending',N'Cancelled') OR S.AdmissionNumber IS NULL)
  THROW 59750,'Complete Admission before issuing an official student certificate. Cancelled records cannot receive certificates.',1;
END;</ns0:Value>
