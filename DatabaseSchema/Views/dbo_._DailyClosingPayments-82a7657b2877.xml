<?xml version='1.0' encoding='utf-8'?>
<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlView" Name="[dbo].[DailyClosingPayments]">
			<ns0:Property Name="QueryScript">
				<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
SELECT P.FeePaymentId, P.PaymentDate, P.PaymentMethod, P.TotalAmount,
       P.ReceiptNumber, P.RelatedFeePaymentId, P.ReferenceNumber, P.CreatedByUserId
FROM dbo.FeePayments P
JOIN dbo.Students S ON S.AdmissionId=P.AdmissionId
JOIN dbo.Enrollments E ON E.EnrollmentId=P.EnrollmentId AND E.AdmissionId=P.AdmissionId
WHERE P.Status=N'Completed'</ns0:Value>
			</ns0:Property>
			<ns0:Property Name="IsAnsiNullsOn" Value="True" />
