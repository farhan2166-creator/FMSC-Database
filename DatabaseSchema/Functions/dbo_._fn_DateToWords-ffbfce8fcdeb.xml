						<ns0:Property Name="BodyScript">
							<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    IF @TheDate IS NULL
        RETURN NULL;

    RETURN
        dbo.fn_NumberToWords(DAY(@TheDate))
        + N' ' + DATENAME(MONTH, @TheDate)
        + N' ' + dbo.fn_NumberToWords(YEAR(@TheDate));
END;</ns0:Value>
