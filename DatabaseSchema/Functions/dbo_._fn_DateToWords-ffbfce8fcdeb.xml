<ns0:Element xmlns:ns0="http://schemas.microsoft.com/sqlserver/dac/Serialization/2012/02" Type="SqlScalarFunction" Name="[dbo].[fn_DateToWords]">
			<ns0:Property Name="IsAnsiNullsOn" Value="True" />
			<ns0:Relationship Name="BodyDependencies">
				<ns0:Entry>
