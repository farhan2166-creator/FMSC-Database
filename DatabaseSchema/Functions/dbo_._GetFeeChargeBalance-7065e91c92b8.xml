			<ns0:Relationship Name="FunctionBody">
				<ns0:Entry>
					<ns0:Element Type="SqlScriptFunctionImplementation">
						<ns0:Property Name="BodyScript">
							<ns0:Value QuotedIdentifiers="True" AnsiNulls="True">
BEGIN
    DECLARE
        @Net DECIMAL(12,2),
        @Paid DECIMAL(12,2);

    SELECT
        @Net = NetAmount
    FROM dbo.BillingCharges
    WHERE BillingChargeId = @BillingChargeId;

    SELECT
        @Paid = ISNULL(SUM(FPA.Amount), 0)
    FROM dbo.FeePaymentAllocations FPA
    INNER JOIN dbo.FeePayments FP
        ON FP.FeePaymentId = FPA.FeePaymentId
       AND FP.Status = N'Completed'
    WHERE FPA.BillingChargeId = @BillingChargeId;

    RETURN
        CASE
            WHEN ISNULL(@Net, 0) - ISNULL(@Paid, 0) &lt; 0
                THEN 0
            ELSE ISNULL(@Net, 0) - ISNULL(@Paid, 0)
        END;
END;</ns0:Value>
