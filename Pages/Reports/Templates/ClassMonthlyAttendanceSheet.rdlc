                              <TextRuns>
                                <TextRun>
                                  <Value>Monthly Attendance Register · </Value>
                                  <Style>
                                    <FontFamily>Segoe UI</FontFamily>
                                    <FontSize>10pt</FontSize>
                                    <FontWeight>Bold</FontWeight>
                                  </Style>
                                </TextRun><TextRun>
