              <Height>4.08cm</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Rectangle Name="MonthlyAttendancePage">
                      <ReportItems>
                        <Textbox Name="SchoolHeading">
                          <CanGrow>true</CanGrow>
                          <KeepTogether>true</KeepTogether>
                          <Paragraphs>
                            <Paragraph>
                              <TextRuns>
                                <TextRun>
                                  <Value>=First(Fields!SchoolName.Value, "PageGroup")</Value>
