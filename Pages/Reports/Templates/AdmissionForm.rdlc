      <Textbox Name="txtDeclaration">
        <CanGrow>true</CanGrow>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>I/We hereby declare that the information provided in this admission form is true and complete to the best of my/our knowledge. I/We agree to abide by the rules, regulations, discipline policy and fee schedule of the school as amended from time to time, and understand that admission is granted at the sole discretion of the school management and is subject to availability of seat. I/We undertake to pay all applicable fees and charges by their due dates and to promptly notify the school of any change in the information given above.</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>9pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style>
              <TextAlign>Center</TextAlign>
            </Style>
          </Paragraph>
        </Paragraphs>
        <Top>6.47in</Top>
        <Height>0.9in</Height>
        <Width>7.27in</Width>
        <ZIndex>20</ZIndex>
        <Style>
