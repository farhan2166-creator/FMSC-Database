      <Tablix Name="AgingAccounts">
        <TablixBody>
          <TablixColumns>
            <TablixColumn>
              <Width>3.02in</Width>
            </TablixColumn>
            <TablixColumn>
              <Width>2.85in</Width>
            </TablixColumn>
            <TablixColumn>
              <Width>1.4in</Width>
            </TablixColumn>
          </TablixColumns>
          <TablixRows>
            <TablixRow>
              <Height>0.78in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="StudentIdentity">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!AdmissionNumber.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontWeight>Bold</FontWeight>
                                <Color>#172b3a</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value> - </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontWeight>Bold</FontWeight>
                                <Color>#172b3a</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Fields!StudentName.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontWeight>Bold</FontWeight>
                                <Color>#172b3a</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!RegistrationNumber.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>  ·  </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Fields!ClassName.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=IIF(Len(Fields!SectionName.Value) &gt; 0, " / ", "")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=IIF(Len(Fields!SectionName.Value) &gt; 0, Fields!SectionName.Value, "")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=Fields!CampusName.Value</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BottomBorder>
                          <Color>#d8e2e7</Color>
                          <Style>Solid</Style>
                          <Width>0.5pt</Width>
                        </BottomBorder>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>6pt</PaddingLeft>
                        <PaddingTop>5pt</PaddingTop>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="AgingBreakdown">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>CURRENT   Rs. </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1f6f5f</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Format(Fields!NotYetDue.Value, "N0")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#1f6f5f</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>1–30   </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#425a68</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Format(Fields!Overdue1To30.Value, "N0")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#425a68</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>     31–60   </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#425a68</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Format(Fields!Overdue31To60.Value, "N0")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>#425a68</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>61–90   </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>=IIf(Fields!Overdue90Plus.Value &gt; 0, "#A33A32", "#425A68")</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Format(Fields!Overdue61To90.Value, "N0")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>=IIf(Fields!Overdue90Plus.Value &gt; 0, "#A33A32", "#425A68")</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>     90+   </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>=IIf(Fields!Overdue90Plus.Value &gt; 0, "#A33A32", "#425A68")</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Format(Fields!Overdue90Plus.Value, "N0")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>8pt</FontSize>
                                <Color>=IIf(Fields!Overdue90Plus.Value &gt; 0, "#A33A32", "#425A68")</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style />
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BottomBorder>
                          <Color>#d8e2e7</Color>
                          <Style>Solid</Style>
                          <Width>0.5pt</Width>
                        </BottomBorder>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingLeft>5pt</PaddingLeft>
                        <PaddingTop>5pt</PaddingTop>
                      </Style>
                    </Textbox>
                  </CellContents>
                </TablixCell>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="AccountTotal">
                      <CanGrow>true</CanGrow>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>Rs. </Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>11pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#172b3a</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Format(Fields!TotalOutstanding.Value, "N0")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>11pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                                <Color>#172b3a</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Right</TextAlign>
                          </Style>
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(Fields!MaxDaysOverdue.Value &gt; 0, CStr(Fields!MaxDaysOverdue.Value), "Current")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>7.5pt</FontSize>
                                <Color>=IIf(Fields!MaxDaysOverdue.Value &gt; 90, "#A33A32", "#58707E")</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=IIF(Fields!MaxDaysOverdue.Value &gt; 0, " days overdue", "")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>7.5pt</FontSize>
                                <Color>=IIf(Fields!MaxDaysOverdue.Value &gt; 90, "#A33A32", "#58707E")</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Right</TextAlign>
                          </Style>
                        </Paragraph>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=IIF(IsNothing(Fields!OldestDueDate.Value), "", "Since ")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>7.5pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=IIF(IsNothing(Fields!OldestDueDate.Value), "", Format(Fields!OldestDueDate.Value, "dd MMM yyyy"))</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>7.5pt</FontSize>
                                <Color>#58707e</Color>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Right</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <BottomBorder>
                          <Color>#d8e2e7</Color>
                          <Style>Solid</Style>
                          <Width>0.5pt</Width>
                        </BottomBorder>
                        <VerticalAlign>Middle</VerticalAlign>
                        <PaddingRight>6pt</PaddingRight>
                        <PaddingTop>5pt</PaddingTop>
                      </Style>
