      </Textbox>
      <Textbox Name="txtSubject">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>SUBJECT:  </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun>
              <TextRun>
                <Value>REQUEST FOR OPENING OF BANK ACCOUNT</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <TextDecoration>Underline</TextDecoration>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>1.7in</Top>
        <Height>0.35in</Height>
        <Width>7.45in</Width>
        <ZIndex>5</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>
      <Textbox Name="txtBody1">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>            With reference to the above subject, it is stated that </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Female", "Miss.", IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Male", "Mr.", "Mr./Ms."))</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!StaffName.Value, "BankAccountOpeningCertificateData")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Female", "D/O", IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Male", "S/O", "S/O, D/O"))</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!FatherName.Value, "BankAccountOpeningCertificateData")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(IsNothing(First(Fields!CNIC.Value, "BankAccountOpeningCertificateData")) OrElse First(Fields!CNIC.Value, "BankAccountOpeningCertificateData") = "", "", " having CNIC No. ")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(IsNothing(First(Fields!CNIC.Value, "BankAccountOpeningCertificateData")) OrElse First(Fields!CNIC.Value, "BankAccountOpeningCertificateData") = "", "", First(Fields!CNIC.Value, "BankAccountOpeningCertificateData"))</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value> is working with us as </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!Designation.Value, "BankAccountOpeningCertificateData") &amp; "."</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(IsNothing(First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData")) OrElse First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData") = 0, "", " ")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(IsNothing(First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData")) OrElse First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData") = 0, "", IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Female", "Her", IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Male", "His", "His/Her")))</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(IsNothing(First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData")) OrElse First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData") = 0, "", " monthly income is about Rs. ")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(IsNothing(First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData")) OrElse First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData") = 0, "", Format(First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData"), "#,0"))</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(IsNothing(First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData")) OrElse First(Fields!MonthlyIncome.Value, "BankAccountOpeningCertificateData") = 0, "", "/-")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>2.3in</Top>
        <Height>1.2in</Height>
        <Width>7.45in</Width>
        <ZIndex>6</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>
      <Textbox Name="txtBody2">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>             It is requested to open a bank account for </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Female", "her", IIF(First(Fields!Gender.Value, "BankAccountOpeningCertificateData") = "Male", "him", "him/her"))</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value xml:space="preserve"> </Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
              <TextRun>
                <Value>=First(Fields!Purpose.Value, "BankAccountOpeningCertificateData")</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>3.6in</Top>
        <Height>0.45in</Height>
        <Width>7.45in</Width>
        <ZIndex>7</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>
      <Textbox Name="txtBody3">
        <CanGrow>true</CanGrow>
        <KeepTogether>true</KeepTogether>
        <Paragraphs>
          <Paragraph>
            <TextRuns>
              <TextRun>
                <Value>             We shall be very thankful for this act of kindness.</Value>
                <Style>
                  <FontFamily>Segoe UI</FontFamily>
                  <FontSize>12pt</FontSize>
                </Style>
              </TextRun>
            </TextRuns>
            <Style />
          </Paragraph>
        </Paragraphs>
        <Top>4.15in</Top>
        <Height>0.3in</Height>
        <Width>7.45in</Width>
        <ZIndex>8</ZIndex>
        <Style>
          <Border>
            <Style>None</Style>
          </Border>
          <VerticalAlign>Middle</VerticalAlign>
        </Style>
      </Textbox>
