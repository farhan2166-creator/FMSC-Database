                        <PaddingRight>2pt</PaddingRight>
                      </Style>
                    </Textbox>
                    <ColSpan>3</ColSpan>
                  </CellContents>
                </TablixCell>
                <TablixCell />
                <TablixCell />
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.16in</Height>
              <TablixCells>
                <TablixCell>
                  <CellContents>
                    <Textbox Name="ReceiptHeading">
                      <CanGrow>true</CanGrow>
                      <CanShrink>true</CanShrink>
                      <Paragraphs>
                        <Paragraph>
                          <TextRuns>
                            <TextRun>
                              <Value>=First(Fields!DocumentTitle.Value, "ReceiptPageGroup")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>6.25pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=" ("</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>6.25pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>=Replace(Replace(First(Fields!CopyLabel.Value, "ReceiptPageGroup"), "STUDENT COPY", "Student Copy"), "CUSTOMER COPY", "Customer Copy")</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>6.25pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                            <TextRun>
                              <Value>)</Value>
                              <Style>
                                <FontFamily>Segoe UI</FontFamily>
                                <FontSize>6.25pt</FontSize>
                                <FontWeight>Bold</FontWeight>
                              </Style>
                            </TextRun>
                          </TextRuns>
                          <Style>
                            <TextAlign>Center</TextAlign>
                          </Style>
                        </Paragraph>
                      </Paragraphs>
                      <Style>
                        <TopBorder>
                          <Style>Solid</Style>
                          <Width>0.5pt</Width>
                        </TopBorder>
                        <BackgroundColor>#f0f0f0</BackgroundColor>
                        <PaddingLeft>2pt</PaddingLeft>
                        <PaddingRight>2pt</PaddingRight>
                        <PaddingTop>1pt</PaddingTop>
                        <PaddingBottom>1pt</PaddingBottom>
                      </Style>
                    </Textbox>
                    <ColSpan>3</ColSpan>
                  </CellContents>
                </TablixCell>
                <TablixCell />
                <TablixCell />
              </TablixCells>
            </TablixRow>
            <TablixRow>
              <Height>0.16in</Height>
              <TablixCells>
